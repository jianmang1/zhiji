# 执己前端 · 构建期环境变量示例（Taro 用 process.env，构建时注入；不要提交真实密钥）
#
# 云函数 HTTP 端点基址（结尾不带斜杠）。留空 = 未配置：
#   - health / dating 打卡会被禁用（契约要求经 recordEvent 加密写入）
#   - /plans 生成会直接提示"端点未绑定"，不会伪造结果
# 形如：https://<envId>.service.tcloudbase.com/<绑定路径>
# 注意：CloudBase 需先为函数绑定「HTTP 访问服务」路径，否则会返回 404 INVALID_PATH。
TARO_APP_CLOUDBASE_FN_BASE_URL=

# CloudBase 环境 ID（ADR-002 默认值）
TARO_APP_CLOUDBASE_ENV=zhiji-d3gd1k9j43e7c20ac

# true = 跳过 cloudbase.init（仅 e2e / 离线截图用，正常构建请保持 false）
TARO_APP_CLOUDBASE_DISABLED=false