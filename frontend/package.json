{
  "name": "zhiji-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "执己 · 从认知到执行 — Taro + CloudBase 原生前端（微信小程序 + H5）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "react"
  },
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@cloudbase/js-sdk": "^3.10.3",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/router": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-react": "^7.24.1",
    "@playwright/test": "^1.49.0",
    "@tarojs/cli": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.18.5",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "babel-preset-taro": "4.3.0",
    "postcss": "^8.4.41",
    "react-refresh": "^0.14.0",
    "sass": "^1.78.0",
    "typescript": "^5.6.2",
    "vitest": "^5.0.5"
  }
}